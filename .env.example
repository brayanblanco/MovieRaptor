# ---------------------------------------------------------------------------
# Copy to `.env` to override the default host paths used by
# docker-compose.override.yml:
#
#     cp .env.example .env
#
# `.env` is gitignored; this template is committed.
#
# On Linux/macOS these default to the standard locations, so creating
# `.env` is OPTIONAL. You only need it if your files live elsewhere.
# ---------------------------------------------------------------------------

# --- Linux / macOS (defaults shown — uncomment only to override) ---
# USER_SECRETS_PATH=/home/you/.microsoft/usersecrets
# DOTNET_CERT_PATH=/home/you/.dotnet/corefx/cryptography/x509stores/my

# --- Windows (Docker Desktop) ---
# Forward slashes are required; backslashes are escape characters here.
# USER_SECRETS_PATH=C:/Users/you/AppData/Roaming/Microsoft/UserSecrets
# DOTNET_CERT_PATH=C:/Users/you/AppData/Roaming/Microsoft/Crypto
#
# Note: HTTPS in the container relies on a Linux x509 certificate store.
# On Windows, use HTTP (http://localhost:8080) for development instead.
